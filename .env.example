# Frontend (Vite) — required for the SPA to boot
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Optional: Convex HTTP/site URL (OAuth callbacks use SITE_URL on the backend)
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# ── Set these in the Convex dashboard (or via `npx convex env set`) ──
# OPENAI_API_KEY=sk-...
# SITE_URL=http://localhost:3000
#
# Auth JWT pair (easiest: npm run auth:setup)
# JWT_PRIVATE_KEY=...
# JWKS=...
#
# Optional OAuth
# AUTH_GITHUB_ID=...
# AUTH_GITHUB_SECRET=...
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
